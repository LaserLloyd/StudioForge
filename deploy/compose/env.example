# Copy to .env next to compose.yml. Every value is optional.
SF_BACKEND=cuda            # cuda | rocm | vulkan
SF_VERSION=2.1.0
SF_BIND=127.0.0.1          # 0.0.0.0 to publish to the LAN (clients then need a key)
# SF_OWNER_USER=owner      # panel owner account, created on the first start of a fresh volume
# SF_OWNER_PASSWORD=       # 10+ characters; empty = generated into /data/owner-password.initial
SF_GATEWAY_PORT=1234
SF_PANEL_PORT=8080
SF_WATCHDOG_PORT=1235
SF_MODELS=./models         # host path of your GGUF library
# SF_ENGINE_BOOTSTRAP=0    # 0 = do not download the llama.cpp engine on the first start (offline hosts)
# SF_DATA=/srv/studioforge # bind-mount the data dir instead of the named volume
# SF_UID=1000
# SF_GID=1000
# SF_VIDEO_GID=44          # rocm / vulkan: numeric gids of `video` and `render`
# SF_RENDER_GID=109
TZ=UTC
